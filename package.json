{
	"name": "cuetone-cueplayer",
	"version": "0.1.5",
	"main": "dist/main.js",
	"type": "module",
	"scripts": {
		"postinstall": "husky",
		"format": "prettier -w .",
		"format:check": "prettier --check .",
		"package": "run build && companion-module-build",
		"build": "rimraf dist && run build:main",
		"build:main": "tsc -p tsconfig.build.json",
		"check-types": "tsc -p tsconfig.json --noEmit",
		"dev": "tsc -p tsconfig.build.json --watch",
		"test": "vitest --run",
		"lint:raw": "eslint",
		"lint": "run lint:raw .",
		"mock": "node test/mock-cueplayer.mjs"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bitfocus/companion-module-cuetone-cueplayer.git"
	},
	"engines": {
		"node": "^26",
		"yarn": "^4"
	},
	"dependencies": {
		"@companion-module/base": "~2.1.3"
	},
	"devDependencies": {
		"@companion-module/tools": "^3.1.1",
		"@types/node": "^26.6.4",
		"eslint": "^10.12.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"prettier": "^3.9.9",
		"rimraf": "^6.1.3",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.71.0",
		"vitest": "^4.1.11"
	},
	"prettier": "@companion-module/tools/.prettierrc.json",
	"lint-staged": {
		"*.{css,json,md,scss}": [
			"prettier --write"
		],
		"*.{ts,tsx,js,jsx}": [
			"yarn lint:raw --fix"
		]
	},
	"packageManager": "yarn@4.18.1",
	"description": "Bitfocus Companion module for CuePlayer (CueTone) — HTTP remote control API v1"
}
